# ===== LLM provider（litellm 按前缀路由，多 provider 可并存）=====
# Z.ai / 智谱（GLM）
ZAI_API_KEY=sk-your-zai-key
# 端点按 key 类型选（默认 https://api.z.ai/api/paas/v4）：
# - Coding Plan 订阅 key：必须用 coding 专用端点（下一行）
# - 普通资源 key：标准端点 https://open.bigmodel.cn/api/paas/v4
ZAI_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# DashScope（qwen，额度用尽暂弃；恢复后填回即可共存）
# DASHSCOPE_API_KEY=sk-your-dashscope-key

# 小米 MiMo（openai_like 端点 api.xiaomimimo.com/v1）
XIAOMI_MIMO_API_KEY=sk-your-mimo-key

# ===== 模型选择（两级：per-agent 覆盖 > 全局默认）=====
# 全局默认模型（litellm 前缀格式），不设则用代码默认 zai/glm-4.6
# 可用：zai/glm-4.6、zai/glm-5.3、xiaomi_mimo/mimo-v2.5-pro、dashscope/qwen-plus
AGENT_INFRA_MODEL=xiaomi_mimo/mimo-v2.5-pro
# 只给某个 agent 换模型（node_id 大写）：
# AGENT_INFRA_MODEL_CR_AGENT=zai/glm-4.6

# ===== 运行产物根目录（trace/artifacts/ADK session sqlite 都在其下）=====
# 不设则默认 <agent_infra>/runs
# AGENT_INFRA_RUNS_DIR=/Users/suke/Python/Agent/agent_infra/runs
